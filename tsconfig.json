{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2024",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/agents-shared/**/*.ts",
    "src/agents-global/**/*.ts",
    "src/apply-patch/**/*.ts",
    "src/bash-cwd/**/*.ts",
    "src/basic-memory/**/*.ts",
    "src/compact-tools/**/*.ts",
    "src/model-system-prompt/**/*.ts",
    "src/provider-fallback/**/*.ts",
    "src/security-gates/**/*.ts",
    "src/skill-whitelist/**/*.ts",
    "src/session-owner/**/*.ts",
    "scripts/pi-session-owner.ts",
    "scripts/ensure-pi-settings.ts",
    "pi/extensions/compact-tools.ts",
    "pi/extensions/session-owner.ts",
    "pi/extensions/agents-shared.ts",
    "pi/extensions/agents-global.ts",
    "src/mcp-policy/**/*.ts",
    "src/task-scheduler/**/*.ts",
    "pi/extensions/mcp-policy.ts",
    "scripts/resolve-physical-pi.ts",
    "scripts/assert-session-tool-policy.ts",
    "scripts/probes/physical-host.ts",
    "src/pi-settings/**/*.ts",
    "src/async-progress/**/*.ts",
    "src/context-usage/**/*.ts",
    "pi/extensions/bash-cwd.ts",
    "pi/extensions/apply-patch.ts",
    "pi/extensions/basic-memory.ts",
    "pi/extensions/context-usage.ts",
    "pi/extensions/task-scheduler.ts",
    "pi/extensions/async-progress-watcher.ts"
  ]
}
