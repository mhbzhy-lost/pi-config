{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": false,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2024",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "pi/extensions/**/*.ts",
    "scripts/**/*.ts",
    "pi/scripts/**/*.ts"
  ]
}
