{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "playwright.ts", "scripts/**/*.ts"]
}
