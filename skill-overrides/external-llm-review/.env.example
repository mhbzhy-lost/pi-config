# external-llm-review secrets (.env) - gitignored.
#
# Provider YAML files contain non-secret endpoint and model settings. This file
# only supplies credentials referenced by ${ENV_VAR} placeholders.

# Idealab Anthropic gateway (providers/idealab-anthropic.yaml)
ANTHROPIC_API_KEY=

# Optional fallback for Idealab OpenAI Qwen (providers/idealab-openai.yaml).
# The resolver first uses: pi auth print-api-key --provider openai-idealab
IDEALAB_OPENAI_API_KEY=
